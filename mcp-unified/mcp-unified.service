[Unit]
Description=MCP Unified Hub — Persistent AI Agent Infrastructure
Documentation=file:///home/aseps/MCP/docs/
After=network.target postgresql.service redis.service
Wants=postgresql.service redis.service

[Service]
Type=simple
User=aseps
WorkingDirectory=/home/aseps/MCP/core/mcp-unified
Environment="PYTHONPATH=/home/aseps/MCP/core/mcp-unified"
# Environment files (TASK-154): all credentials are consolidated in config/env/.
# Order mirrors scripts/load_env.py — later files override earlier ones.
EnvironmentFile=/home/aseps/MCP/config/env/.env.core
EnvironmentFile=/home/aseps/MCP/config/env/.env.ai
EnvironmentFile=/home/aseps/MCP/config/env/.env.workspace
EnvironmentFile=/home/aseps/MCP/config/env/.env.cloud
EnvironmentFile=/home/aseps/MCP/config/env/.env.messaging
EnvironmentFile=/home/aseps/MCP/config/env/.env.integrations
EnvironmentFile=/home/aseps/MCP/config/env/.env.openhands
EnvironmentFile=/home/aseps/MCP/config/env/.env.remote-access

# [REVIEWER] ExecStart menggunakan python3 langsung
# Ganti path python3 jika menggunakan virtualenv
ExecStart=/home/aseps/MCP/.venv/bin/python3 /home/aseps/MCP/core/mcp-unified/mcp_server_sse.py

# Restart policy — restart otomatis jika crash, tunggu 5 detik
Restart=always
RestartSec=5

# Logging ke systemd journal
StandardOutput=journal
StandardError=journal
SyslogIdentifier=mcp-unified

# Resource limits
TimeoutStartSec=30
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
